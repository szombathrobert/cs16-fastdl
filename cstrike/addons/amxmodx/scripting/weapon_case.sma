public plugin_init() {
	register_plugin(PLUGIN, VERSION, AUTHOR)
	
	register_event("ResetHUD", "Event_ResetHUD", "b")
	
	register_touch("ct_case" ,"player" ,"ct_touched")
	register_touch("t_case" ,"player" ,"t_touched")
	
	register_logevent("round_end", 2, "1=Round_End")
	register_logevent("round_start", 2, "1=Round_Start")
	
	register_cvar("weapc_killentity", "30.0")
	register_cvar("weapc_needplaytowp", "3")
	register_cvar("weapc_allsniper", "3")
	register_cvar("weapc_gotflash", "2")
	register_cvar("weapc_gotheg", "1")
	register_cvar("weapc_gotsmoke", "1")
	register_cvar("weapc_usepistolmenu", "1")
	
	RegisterHam(Ham_Spawn, "player", "fw_player_spawn_post", 1)
	register_message(get_user_msgid("StatusIcon"), "Message_StatusIcon");
	register_event("ResetHUD", "Event_ResetHUD", "b")
	set_msg_block(get_user_msgid("Money"), BLOCK_SET)
}
public fw_player_spawn_post(id)
{
	choosedGun[id][0] = false
	choosedGun[id][1] = false
}
public ct_touched(ent, id)
{
	open_WeapMENU(id)
	fm_strip_user_gun(id, 16, "weapon_usp")
	fm_strip_user_gun(id, 17, "weapon_glock18")
}
public t_touched(ent, id)
{
	open_WeapMENU(id)
	fm_strip_user_gun(id, 16, "weapon_usp")
	fm_strip_user_gun(id, 17, "weapon_glock18")
}
public plugin_precache()
{
	precache_model(case_model)
	precache_sound(case_sound)
}
public round_end()
{
	static id
	for(id = 1; id <= get_maxplayers(); id++) {
		strip_user_weapons(id)
		killEntity(id)
	}
}
public round_start()
{
	static id
	
	t_CaseLoad()
	ct_CaseLoad()
	
	for(id = 1; id <= get_maxplayers(); id++){
		set_task(get_cvar_float("weapc_killentity"), "killEntity", id)
		client_cmd(id, "spk %s", case_sound)
	}
	
	set_dhudmessage(0, 255, 0, -1.0, 0.16, 2, 6.0, 15.0)
	show_dhudmessage(0, "A fegyveres lada megjelent!^n%3.0f mp-ig tudtok vasarolni azutan eltunik.", get_cvar_float("weapc_killentity"))
}
public killEntity(id)
{
	new fm_Null[2] = FM_NULLENT
	while((fm_Null[0] = fm_find_ent_by_class(fm_Null[0], "ct_case")))
	{
		engfunc(EngFunc_RemoveEntity, fm_Null[0]);
	}
	while((fm_Null[1] = fm_find_ent_by_class(fm_Null[1], "t_case")))
	{
		engfunc(EngFunc_RemoveEntity, fm_Null[1]);
	}
	set_dhudmessage(0, 255, 0, -1.0, 0.16, 2, 6.0, 5.0)
	show_dhudmessage(0, "Letelt a fegyver vasarlasi ido!")
	menu_destroy(menu_Pistol)
	menu_destroy(menu_Weapon)
	remove_task(id)
}
public ct_CaseLoad()
{
	new Float:origin[3]

	origin[0] = 325.0
	origin[1] = 2305.0
	origin[2] = -91.0
	
	new ent = create_entity("info_target")
	
	set_pev(ent, pev_classname, "ct_case")
	entity_set_model(ent, case_model)
	set_pev(ent,pev_solid, SOLID_BBOX)
	set_pev(ent, pev_movetype, MOVETYPE_TOSS)
	engfunc(EngFunc_SetOrigin, ent, origin)
	engfunc(EngFunc_SetSize, ent, Float:{-10.0,-10.0,0.0}, Float:{10.0,10.0,25.0})
	engfunc(EngFunc_DropToFloor, ent)
}
public t_CaseLoad()
{
	new Float:origin[3]

	origin[0] = -650.0
	origin[1] = -771.0
	origin[2] = 164.0
	
	new ent = create_entity("info_target")
	
	set_pev(ent, pev_classname, "t_case")
	entity_set_model(ent, case_model)
	set_pev(ent,pev_solid, SOLID_BBOX)
	set_pev(ent, pev_movetype, MOVETYPE_TOSS)
	engfunc(EngFunc_SetOrigin, ent, origin)
	engfunc(EngFunc_SetSize, ent, Float:{-10.0,-10.0,0.0}, Float:{10.0,10.0,25.0})
	engfunc(EngFunc_DropToFloor, ent)
}
public open_WeapMENU(id)
{
	if(choosedGun[id][0] && choosedGun[id][1]) {
		return PLUGIN_HANDLED
	}
	if(choosedGun[id][0] && !choosedGun[id][1]) {
		open_PistolMENU(id)
		return PLUGIN_HANDLED
	}
	
	new szMenu[121]
	formatex(szMenu, charsmax(szMenu), "\r%s \yValassz Fegyvert", prefix)
	menu_Weapon = menu_create(szMenu, "choose_Gun");

	for(new i=0; i < sizeof(Weapons); i++){
		formatex(szMenu, charsmax(szMenu), "%s%s", Weapons[i][0], get_cvar_num("weapc_usepistolmenu") ? "" : " \yCsomag")
		menu_additem(menu_Weapon, szMenu, "", 0)
	}
	
	menu_display(id, menu_Weapon, 0)
	return PLUGIN_CONTINUE
}
public choose_Gun(id, menu_Weapon, item)
{
	if(item == MENU_EXIT)
	{
		menu_destroy(menu_Weapon);
		return PLUGIN_CONTINUE;
	}

	new iPlayers[32], iNumCT , iNumT;
	get_players(iPlayers, iNumCT, "e", "CT" );
	get_players(iPlayers, iNumT, "e", "TERRORIST");
	
	if(item == 2)
	{
		if(iNumCT < 4 && iNumT < 4){
			ColorChat(id, GREEN, "^4%s ^1Legalabb ^3%iv%i ^1kell legyen az AWP hasznalatahoz!", prefix, get_cvar_num("weapc_needplaytowp"), get_cvar_num("weapc_needplaytowp"));
			return PLUGIN_HANDLED;
		}
		else if(get_cvar_num("weapc_allsniper"))
		{
			if(tUseWP > 3) {
				ColorChat(id, GREEN, "^4%s ^1Csapatodba max csak ^3%i ^1hasznalhat AWP-t!", prefix, get_cvar_num("weapc_allsniper"))
				return PLUGIN_HANDLED;
			}
			if(ctUseWP > 3) {
				ColorChat(id, GREEN, "^4%s ^1Csapatodba max csak ^3%i ^1hasznalhat AWP-t!", prefix, get_cvar_num("weapc_allsniper"))
				return PLUGIN_HANDLED;
			}
			switch(cs_get_user_team(id))
			{
				case CS_TEAM_CT: if(tUseWP < get_cvar_num("weapc_allsniper")) tUseWP++
				case CS_TEAM_T: if(ctUseWP < get_cvar_num("weapc_allsniper")) ctUseWP++
			}
		}
	}
	
	give_item(id, Weapons[item][1]);
	cs_set_user_bpammo(id, WeaponCSW[item][0], WeaponCSW[item][1])
	ColorChat(id, GREEN, "^4%s ^3%s%s ^1sikeresen kivalasztva.", prefix, Weapons[item][0], get_cvar_num("weapc_usepistolmenu") ? "" : " Csomag")
	choosedGun[id][0] = true
	
	if(!get_cvar_num("weapc_usepistolmenu")){
		give_item(id, "weapon_deagle")
		cs_set_user_bpammo(id, CSW_DEAGLE, 35)
		
		addEquipMents(id)
	}
	else {
		open_PistolMENU(id)
	}
	
	menu_destroy(menu_Weapon);
	return PLUGIN_HANDLED;
}
public open_PistolMENU(id)
{
	new szMenu[121]
	formatex(szMenu, charsmax(szMenu), "\r%s \yValassz Pisztolyt", prefix)
	menu_Pistol = menu_create(szMenu, "choose_Pistol");

	for(new i=0; i < sizeof(Pistols); i++){
		formatex(szMenu, charsmax(szMenu), "%s", Pistols[i][0])
		menu_additem(menu_Pistol, szMenu, "", 0)
	}
	
	menu_display(id, menu_Pistol, 0)
}
public choose_Pistol(id, menu_Pistol, item)
{
	if(item == MENU_EXIT)
	{
		menu_destroy(menu_Pistol);
		return PLUGIN_CONTINUE;
	}

	give_item(id, Pistols[item][1]);
	cs_set_user_bpammo(id, PistolCSW[item][0], PistolCSW[item][1])
	ColorChat(id, GREEN, "^4%s ^3%s ^1pistoly sikeresen kivalasztva.", prefix, Pistols[item][0])
	
	addEquipMents(id)

	menu_destroy(menu_Pistol);
	return PLUGIN_CONTINUE;
}
public Event_ResetHUD(id) {
	set_pdata_int(id, 362, 0)
	set_pdata_int(id, 361, 1<<5)
}
public Message_StatusIcon(iMsgId, iMsgDest, id) {
	static szIcon[8];
	get_msg_arg_string(2, szIcon, charsmax(szIcon));
	if(equal(szIcon, "buyzone")) {
		if(get_msg_arg_int(1)) {
			set_pdata_int(id, 235, get_pdata_int(id, 235) & ~(1<<0));
			return PLUGIN_HANDLED;
		}
	}
	return PLUGIN_CONTINUE;
}
public addEquipMents(id) {
	if(cs_get_user_team(id) == CS_TEAM_CT) give_item(id, "item_thighpack")
		
	give_item(id, "item_assaultsuit")
	give_item(id, "weapon_knife")
		
	if(get_cvar_num("weapc_gotflash")) {
		give_item(id, "weapon_flashbang")
		cs_set_user_bpammo(id, CSW_FLASHBANG, get_cvar_num("weapc_gotflash"))
	}
	if(get_cvar_num("weapc_gotheg")) {
		give_item(id, "weapon_hegrenade")
		cs_set_user_bpammo(id, CSW_HEGRENADE, get_cvar_num("weapc_gotheg"))
	}
	if(get_cvar_num("weapc_gotsmoke")) {
		give_item(id, "weapon_smokegrenade")
		cs_set_user_bpammo(id, CSW_SMOKEGRENADE, get_cvar_num("weapc_gotsmoke"))
	}
	choosedGun[id][1] = true
}
