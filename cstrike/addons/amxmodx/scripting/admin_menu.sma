/* Plugin generated by AMXX-Studio */

#include <amxmodx>
#include <amxmisc>

#define PLUGIN "Basic Admin Menu"
#define VERSION "1.0"
#define AUTHOR "Blizzard"


public plugin_init() {
	register_plugin(PLUGIN, VERSION, AUTHOR)
	
	register_clcmd("say /menu", "AdminMenu", ADMIN_KICK);
	register_concmd("menu", "AdminMenu", ADMIN_KICK);
}
 public AdminMenu(id)
 {

    new menu = menu_create("\rAmXmodX Menü:", "AdminMenu_handler");

    menu_additem(menu, "\rKirúgás menü", "1", 0);
    menu_additem(menu, "\rBan menü", "2", 0);
    menu_additem(menu, "\yMegütés/Megölés menü", "3", 0);
    menu_additem(menu, "\yCsapat menü", "4", 0);
    menu_additem(menu, "\yPálya választás", "5", 0);
    menu_additem(menu, "\yPálya szavazás", "6", 0);
    
    menu_setprop(menu, MPROP_EXIT, MEXIT_ALL);

    menu_display(id, menu, 0);
}
 public AdminMenu_handler(id, menu, item)
 {
  
    if( item == MENU_EXIT )
    {
        menu_destroy(menu);
 
        return PLUGIN_HANDLED;
    }


    new data[6], szName[64];
    new access, callback;

    menu_item_getinfo(menu, item, access, data,charsmax(data), szName,charsmax(szName), callback);
    
    new key = str_to_num(data);

    switch(key)
    {
        case 1:
        {
         client_cmd(id, "amx_kickmenu");
        }
        case 2:
        {
         client_cmd(id, "amx_banmenu");
        }
        case 3:
        {
         client_cmd(id, "amx_slapmenu");
        }
        case 4:
        {
         client_cmd(id, "amx_teammenu");
        }
        case 5:
        {
         client_cmd(id, "amx_mapmenu");
        }
        case 6:
        {
         client_cmd(id, "amx_votemapmenu");
        }
    }

    menu_destroy(menu);
    return PLUGIN_HANDLED;
 }